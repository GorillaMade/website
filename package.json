{
  "name": "gorillamade",
  "type": "module",
  "version": "0.0.1",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "styles:build": "sass --no-source-map sass/base.scss:src/styles/base.css sass/patterns.scss:src/styles/patterns.css sass/utilities.scss:src/styles/utilities.css sass/global.scss:src/styles/global.css",
    "styles:watch": "sass --watch --no-source-map sass/base.scss:src/styles/base.css sass/patterns.scss:src/styles/patterns.css sass/utilities.scss:src/styles/utilities.css sass/global.scss:src/styles/global.css",
    "predev": "npm run styles:build",
    "dev": "concurrently -k \"npm:styles:watch\" \"astro dev\"",
    "prebuild": "npm run styles:build",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/alpinejs": "^1.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@types/alpinejs": "^3.13.11",
    "alpinejs": "^3.17.3",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "concurrently": "^9.2.1",
    "sass": "^1.104.1",
    "typescript": "^5.9.2"
  },
  "allowScripts": { "esbuild": true }
}
