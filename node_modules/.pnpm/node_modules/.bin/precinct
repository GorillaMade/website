#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/tjay/Projects/Git/website/node_modules/.pnpm/precinct@12.3.2/node_modules/precinct/node_modules:/home/tjay/Projects/Git/website/node_modules/.pnpm/precinct@12.3.2/node_modules:/home/tjay/Projects/Git/website/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/tjay/Projects/Git/website/node_modules/.pnpm/precinct@12.3.2/node_modules/precinct/node_modules:/home/tjay/Projects/Git/website/node_modules/.pnpm/precinct@12.3.2/node_modules:/home/tjay/Projects/Git/website/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../precinct/bin/cli.js" "$@"
else
  exec node  "$basedir/../precinct/bin/cli.js" "$@"
fi
