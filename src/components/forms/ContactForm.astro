---
import Button from "@/components/ui/Button.astro";

const services = [
    {
        value: "branding",
        label: "Brand Strategy & Identity",
    },
    {
        value: "website",
        label: "Website Development",
    },
    {
        value: "marketing",
        label: "Seo Marketing",
    },
    {
        value: "other",
        label: "Anders",
    },
];
---

<form
    id="contact"
    class="contact-form"
    method="POST"
    action="/send"
    hx-post="/send"
    hx-target="#form-container"
    hx-swap="innerHTML"
>
    <div class="contact-form__group">
        <label for="name">Naam</label>

        <input
            type="text"
            id="name"
            name="name"
            placeholder="Jouw naam"
            required
        />
    </div>

    <div class="contact-form__group">
        <label for="email">E-mail</label>

        <input
            type="email"
            id="email"
            name="email"
            placeholder="jij@bedrijf.nl"
            required
        />
    </div>

    <div class="contact-form__group">
        <label for="service">Waar ben je naar op zoek?</label>

        <select id="service" name="service">
            {
                services.map(({ value, label }) => (
                    <option value={value}>{label}</option>
                ))
            }
        </select>
    </div>

    <div class="contact-form__group">
        <label for="message">Vertel iets over jouw project</label>

        <textarea
            id="message"
            name="message"
            rows="6"
            placeholder="Vertel kort wat je zoekt..."
            required></textarea>
    </div>

    <Button variant="accent">Versturen</Button>
</form>

<style lang="scss">
    .contact-form {
        --button-foreground: var(--color-neutral-900);
        --button-background: var(--color-accent);
        display: flex;
        flex-direction: column;
        gap: var(--gap-m);

        &__group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        label {
            font-size: var(--fs--1);
            color: var(--color-neutral-300);
        }

        input,
        textarea,
        select {
            width: 100%;
            border: 1px solid var(--border-subtile);
            background: var(--color-neutral-800);
            color: var(--color-neutral-0);
            border: 1px solid var(--border-color, transparent);
            border-radius: 0.75rem;
            padding: 0.9rem 1rem;
            font: inherit;
            resize: vertical;
            transition:
                border-color var(--duration-normal) var(--ease-default),
                background var(--duration-normal) var(--ease-default);

            &:focus {
                --border-color: var(--color-accent);
                outline: none;
            }
        }
    }
</style>
