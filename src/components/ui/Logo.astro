<style lang="scss">
    .brand {
        flex-shrink: 0;
        display: flex;
        color: var(--color-text);
        font-family: var(--ff-base);
        font-size: var(--fs-0);
        font-weight: var(--fw-bold);
        text-decoration: none;
        align-items: center;
        gap: var(--space-2xs);

        svg {
            min-height: auto;
            min-width: 35px;
        }

        &:is(:hover, :focus-visible) {
            color: var(--color-text-secondary);
        }

        @media (width < 975px) {
            flex: 1;
        }

        .fw-light {
            font-weight: var(--fw-light);
        }
    }
</style>

<style is:global>
    @media (width < 490px) {
        .site-header .brand .brand__name {
            display: none;
        }
    }
</style>
