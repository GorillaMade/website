---
interface Props {
    href?: string;
    variant: "post" | "showcase";
    class?: string;
    style?: string; // bv. `--delay-stagger: 2` vanuit de grid-loop
}

const { href, variant, class: className, style } = Astro.props;
---

{
    href ? (
        <a
            href={href}
            class:list={["card", `card--${variant}`, className]}
            style={style}
        >
            <slot />
        </a>
    ) : (
        <article
            class:list={["card", `card--${variant}`, className]}
            style={style}
        >
            <slot />
        </article>
    )
}

<style lang="scss">
    .card {
        display: flex;
        flex-direction: column;
        border-radius: var(--radius-l);
        background: var(--color-surface-raised);
        border: 1px solid var(--color-border);
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        height: 100%;
        transition:
            transform var(--duration-normal) var(--ease-in),
            box-shadow var(--duration-normal) var(--ease-in),
            background var(--duration-slow) var(--ease-in);

        @supports (animation-timeline: view()) {
            @media (prefers-reduced-motion: no-preference) {
                animation: card-in 1s both;
                animation-play-state: paused;
                animation-delay: calc(var(--delay-stagger, 0s) * 0.25s);

                @container style(--in-view: true) {
                    animation-play-state: running;
                }
            }
        }

        /* Variant-specifieke hover — moet hier wonen, niet in PostCard/ShowcaseCard,
           omdat dit element (article/a) door Card.astro zelf gerenderd wordt. */
        &--post:is(:hover, :focus-visible) {
            transform: translateY(-4px);
            box-shadow: var(--shadow-xl);
        }

        &--showcase {
            padding: var(--padding-m);
            border-radius: var(--radius-xl);

            &:is(:hover, :focus-visible) {
                background: var(--surface-subtle);
            }
        }
    }

    @keyframes card-in {
        from {
            opacity: 0;
            translate: 0 2rem;
            scale: 0.96;
        }
        to {
            opacity: 1;
            translate: 0 0;
            scale: 1;
        }
    }
</style>
