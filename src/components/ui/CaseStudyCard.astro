---
import type { CollectionEntry } from "astro:content";
import Button from "@/components/ui/Button.astro";

interface Props {
    showcase: CollectionEntry<"showcase">;
}

const { showcase } = Astro.props;

const { title, client, year, logo, description, services } = showcase.data;
---

<article class="showcase-card fade-in">
    <!-- Logo -->
    <div class="logo-wrapper">
        <img src={logo?.src} alt={`${client} logo`} class="client-logo" />
    </div>

    <!-- Projectnaam -->
    <h3 class="project-name">
        <a href={`/showcases/${showcase.id}`}>{title}</a>
    </h3>

    <!-- Meta: services + jaar -->
    <p class="meta">
        {services.join(", ")}
        <span class="meta-sep" aria-hidden="true">·</span>
        {year}
    </p>

    <!-- Body paragrafen -->
    <div class="body-text">
        {description}
    </div>

    <!-- CTA naar case study pagina -->
    <Button
        classList="readmore"
        href={`/showcases/${showcase.id}`}
        aria-label={`Bekijk case study: ${title}`}>Bekijk case study</Button
    >
</article>

<style is:inline>
    .showcase-card {
        border-top: 1px solid #e5e7eb;
        padding-top: 3rem;
        padding-bottom: 3rem;
    }

    /* Logo */
    .logo-wrapper {
        margin-bottom: 1.5rem;
    }

    .client-logo {
        height: 1.75rem;
        width: auto;
        display: block;
    }

    /* Projectnaam */
    .project-name {
        font-family: Georgia, serif;
        font-size: 1.5rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: #111827;
        margin: 0 0 0.5rem;
    }

    .project-name a {
        color: inherit;
        text-decoration: none;
    }

    .project-name a:hover {
        color: #374151;
    }

    /* Meta */
    .meta {
        font-size: 0.875rem;
        color: #6b7280;
        margin: 0 0 1.5rem;
    }

    .meta-sep {
        margin: 0 0.5rem;
        color: #d1d5db;
    }

    /* Tagline (description als externe link) */
    .tagline-link {
        display: block;
        font-family: Georgia, serif;
        font-size: 1.0625rem;
        font-weight: 600;
        color: #111827;
        text-decoration: none;
        margin-bottom: 1.25rem;
        line-height: 1.45;
        transition: color 0.15s ease;
    }

    .tagline-link:hover {
        color: #374151;
    }

    /* Body tekst */
    .body-text {
        margin-bottom: 1.75rem;
    }

    .body-text p {
        font-size: 0.9375rem;
        color: #374151;
        line-height: 1.75;
        margin: 0 0 0.875rem;
    }

    .body-text p:last-child {
        margin-bottom: 0;
    }

    .readmore {
        --button-font-size: var(--font-size--2);
        --button-font-weight: var(--font-weight-bold);
        --button-border-radius: var(--radius-full);
    }
</style>
