---
import Button from "@/components/Button.astro";

interface Props {
    services?: string[];
    buttonLabel?: string;
}

const { services = [], buttonLabel = "Verstuur aanvraag" } = Astro.props;
---

<form class="contact-form" method="post">
    <div class="contact-form__fields">
        <div class="field">
            <label for="name">Naam</label>

            <input
                id="name"
                name="name"
                type="text"
                autocomplete="name"
                required
            />
        </div>

        <div class="field">
            <label for="email">E-mail</label>

            <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
            />
        </div>

        <div class="field">
            <label for="company">
                Bedrijf
                <span>Optioneel</span>
            </label>

            <input
                id="company"
                name="company"
                type="text"
                autocomplete="organization"
            />
        </div>
    </div>

    {services.length > 0 && (
        <fieldset class="contact-form__services">
            <legend>Waar kan ik mee helpen?</legend>

            <div class="contact-form__service-grid">
                {services.map((service) => (
                    <label class="service-option">
                        <input
                            type="checkbox"
                            name="services"
                            value={service}
                        />

                        <span>
                            {service}

                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path
                                    d="m6 12 4 4 8-8"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                />
                            </svg>
                        </span>
                    </label>
                ))}
            </div>
        </fieldset>
    )}

    <div class="field">
        <label for="message">Vertel kort over je project</label>

        <textarea id="message" name="message" rows="7" required></textarea>
    </div>

    <div class="contact-form__submit">
        <Button type="submit">{buttonLabel}</Button>
    </div>
</form>

<style lang="scss">
    .contact-form {
        display: grid;
        gap: var(--space-l);
    }

    .contact-form__fields {
        display: grid;
        gap: var(--space-m);
    }

    .field {
        display: grid;
        gap: var(--space-xs);

        label {
            display: flex;
            justify-content: space-between;
            gap: var(--space-s);

            color: var(--text-primary);

            font-size: var(--text-small);
            font-weight: var(--fw-semibold);

            span {
                color: var(--text-muted);
                font-weight: var(--fw-body);
            }
        }

        input,
        textarea {
            width: 100%;

            padding: var(--space-s) var(--space-m);

            color: var(--text-primary);
            background-color: var(--surface-subtle);

            border: 1px solid var(--border-default);
            border-radius: var(--radius-s);

            font: inherit;

            transition:
                border-color var(--duration-fast) var(--ease-ease-out),
                background-color var(--duration-fast) var(--ease-ease-out);

            &:hover {
                border-color: var(--border-strong);
            }

            &:focus-visible {
                outline: var(--focus-width) solid var(--focus-ring);
                outline-offset: var(--focus-offset);
            }
        }

        textarea {
            resize: vertical;
        }
    }

    .contact-form__services {
        margin: 0;
        padding: 0;

        border: 0;

        legend {
            margin-block-end: var(--space-s);

            color: var(--text-primary);

            font-size: var(--text-small);
            font-weight: var(--fw-semibold);
        }
    }

    .contact-form__service-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-xs);

        @media (width <= 36rem) {
            grid-template-columns: 1fr;
        }
    }

    .service-option {
        cursor: pointer;

        input {
            position: absolute;

            width: 1px;
            height: 1px;

            opacity: 0;
            pointer-events: none;
        }

        > span {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: var(--space-s);

            min-height: var(--space-xl);

            padding: var(--space-s) var(--space-m);

            color: var(--text-primary);
            background-color: var(--surface-subtle);

            border: 1px solid var(--border-default);
            border-radius: var(--radius-s);

            transition:
                color var(--duration-fast) var(--ease-ease-out),
                background-color var(--duration-fast) var(--ease-ease-out),
                border-color var(--duration-fast) var(--ease-ease-out);

            svg {
                width: var(--space-m);
                height: var(--space-m);

                opacity: 0;

                transition: opacity var(--duration-fast) var(--ease-ease-out);
            }
        }

        &:hover > span {
            border-color: var(--border-strong);
        }

        input:checked + span {
            color: var(--action-primary-text);
            background-color: var(--action-primary);
            border-color: var(--action-primary);
        }

        input:checked + span svg {
            opacity: 1;
        }

        input:focus-visible + span {
            outline: var(--focus-width) solid var(--focus-ring);
            outline-offset: var(--focus-offset);
        }
    }

    .contact-form__submit {
        display: flex;

        padding-block-start: var(--space-xs);
    }
</style>
