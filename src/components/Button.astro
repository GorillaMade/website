---
import type { HTMLAttributes } from "astro/types";

type ButtonVariant = "primary" | "secondary" | "outline" | "ghost";

type ButtonSize = "small" | "medium" | "large";

interface Props extends HTMLAttributes<"button"> {
    /** Rendert als link wanneer href aanwezig is. */
    href?: string;

    /** Visuele variant. */
    variant?: ButtonVariant;

    /** Grootte van de button. */
    size?: ButtonSize;

    /** Vult de beschikbare breedte. */
    fullWidth?: boolean;

    /** Schakelt de button uit. */
    disabled?: boolean;

    class?: string;
}

const {
    href,
    variant = "primary",
    size = "medium",
    fullWidth = false,
    disabled = false,
    class: className,
    ...rest
} = Astro.props;

const Tag = href ? "a" : "button";
---

<Tag
    class:list={["button", className]}
    data-variant={variant}
    data-size={size}
    data-full-width={fullWidth || undefined}
    href={href}
    disabled={!href ? disabled : undefined}
    aria-disabled={href && disabled ? "true" : undefined}
    {...rest}
>
    <span class="button__label">
        <slot />
    </span>
</Tag>

<style lang="scss">
    .button {
        // ---------------------------------------------------------------------
        // Private component tokens
        // ---------------------------------------------------------------------

        --_button-background: var(--button-background, var(--action-primary));

        --_button-background-hover: var(
            --button-background-hover,
            var(--action-primary-hover)
        );

        --_button-background-active: var(
            --button-background-active,
            var(--action-primary-active)
        );

        --_button-color: var(--button-color, var(--action-primary-text));

        --_button-border-color: var(--button-border-color, transparent);

        --_button-padding-block: var(--button-padding-block, var(--space-s));

        --_button-padding-inline: var(--button-padding-inline, var(--space-m));

        --_button-radius: var(--button-radius, var(--radius-s));

        --_button-gap: var(--button-gap, var(--space-2xs));

        // ---------------------------------------------------------------------
        // Layout
        // ---------------------------------------------------------------------

        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--_button-gap);

        min-height: 2.75rem;

        padding-block: var(--_button-padding-block);
        padding-inline: var(--_button-padding-inline);

        // ---------------------------------------------------------------------
        // Appearance
        // ---------------------------------------------------------------------

        color: var(--_button-color);
        background-color: var(--_button-background);

        border: 1px solid var(--_button-border-color);
        border-radius: var(--_button-radius);

        // ---------------------------------------------------------------------
        // Typography
        // ---------------------------------------------------------------------

        font: inherit;
        font-weight: var(--fw-semibold);
        line-height: var(--lh-none);

        text-align: center;
        text-decoration: none;

        // ---------------------------------------------------------------------
        // Interaction
        // ---------------------------------------------------------------------

        cursor: pointer;

        transition:
            color var(--duration-fast) var(--ease-out),
            background-color var(--duration-fast) var(--ease-out),
            border-color var(--duration-fast) var(--ease-out);

        &:hover {
            background-color: var(--_button-background-hover);
        }

        &:active {
            background-color: var(--_button-background-active);
        }

        &:focus-visible {
            outline: var(--focus-width) solid var(--focus-ring);

            outline-offset: var(--focus-offset);
        }

        &:disabled,
        &[aria-disabled="true"] {
            cursor: not-allowed;
            opacity: 0.5;
        }

        &[aria-disabled="true"] {
            pointer-events: none;
        }

        &[data-full-width] {
            width: 100%;
        }
    }

    // -------------------------------------------------------------------------
    // Variants
    // -------------------------------------------------------------------------

    .button[data-variant="secondary"] {
        --button-background: var(--action-secondary);
        --button-background-hover: var(--action-secondary-hover);
        --button-background-active: var(--action-secondary-active);
        --button-color: var(--action-secondary-text);
    }

    .button[data-variant="outline"] {
        --button-background: var(--action-outline);
        --button-background-hover: var(--action-outline-hover);
        --button-background-active: var(--action-outline-active);
        --button-color: var(--action-outline-text);
        --button-border-color: var(--action-outline-border);
    }

    .button[data-variant="ghost"] {
        --button-background: var(--action-ghost);
        --button-background-hover: var(--action-ghost-hover);
        --button-background-active: var(--action-ghost-active);
        --button-color: var(--action-ghost-text);
    }

    // -------------------------------------------------------------------------
    // Sizes
    // -------------------------------------------------------------------------

    .button[data-size="small"] {
        --button-padding-block: var(--space-xs);
        --button-padding-inline: var(--space-s);

        min-height: 2.375rem;

        font-size: var(--text-small);
    }

    .button[data-size="large"] {
        --button-padding-block: var(--space-m);
        --button-padding-inline: var(--space-l);

        min-height: 3.25rem;

        font-size: var(--text-large);
    }

    // -------------------------------------------------------------------------
    // Reduced motion
    // -------------------------------------------------------------------------

    @media (prefers-reduced-motion: reduce) {
        .button {
            transition: none;
        }
    }
</style>
