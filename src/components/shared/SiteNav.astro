---
const navItems = [
    { label: "Werk", href: "/showcases" },
    { label: "Over", href: "/about" },
    { label: "Blog", href: "/blog" },
];

const currentPath = Astro.url.pathname;
---

<nav id="site-nav" class="site-nav">
    <ul class="site-nav__list">
        {
            navItems.map((item) => (
                <li class="site-nav__item">
                    <a
                        href={item.href}
                        class="site-nav__link"
                        aria-current={
                            currentPath === item.href ||
                            currentPath.startsWith(`${item.href}/`)
                                ? "page"
                                : undefined
                        }
                    >
                        {item.label}
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

<style lang="scss">
    .site-nav {
        --_nav-width: var(--nav-width, 100%);
        display: none;
        width: var(--_nav-width);
        padding-block: var(--space-m);

        &__list {
            width: var(--_nav-width);
            list-style: none;
            margin: 0;
            padding: 0;
        }

        &__item {
            position: relative;
            margin-inline: var(--space-xs);
        }

        &__link {
            --_nav-link-foreground: var(
                --nav-link-foreground,
                var(--color-text-muted)
            );
            position: relative;
            display: block;
            text-align: center;
            color: var(--_nav-link-foreground);
            font-size: var(--text-s);
            font-weight: var(--fw-medium);
            text-transform: uppercase;
            letter-spacing: var(--tracking-wide);
            padding-block: 0.25rem;

            text-decoration: none;

            &:is(:hover, :focus-visible) {
                --nav-link-foreground: var(--color-text-secondary);
                font-weight: var(--fw-medium);
            }

            &[aria-current="page"] {
                --nav-link-foreground: var(--color-text);
                font-weight: var(--fw-semibold);
            }
        }
    }

    :global(.site-nav.open),
    :global(.site-nav[aria-expanded="true"]) {
        display: block;
    }

    .site-nav > .site-nav__list > li > a {
        &:after {
            content: "";
            position: absolute;
            left: 0;
            bottom: 0;
            width: 100%;
            height: 0.15rem;
            background-color: var(--_nav-link-foreground);
            transform: scaleX(0);
            transition: transform 0.15s ease-in-out;
        }

        &:is(:hover, :focus-visible):after,
        &[aria-current="page"]:after {
            transform: scaleX(1) translateY(0);
            opacity: 1;
        }
    }

    @media (width > 975px) {
        .site-nav {
            --nav-width: auto;
            width: var(--_nav-width);
            display: flex;
            padding-block: 0;

            &__list {
                width: var(--_nav-width);
                display: flex;
                gap: 1rem;
            }

            &__item {
                width: var(--_nav-width);
            }
        }
    }

    @media (width < 975px) {
        .site-nav {
            order: 3;

            &__item {
                padding: var(--space-s);
            }
        }
    }
</style>
