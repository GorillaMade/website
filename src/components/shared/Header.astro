---
import Logo from "@/components/ui/Logo.astro";
import Hamburger from "@/components/ui/Hamburger.astro";
import SiteNav from "@/components/shared/SiteNav.astro";
import Button from "@/components/ui/Button.astro";
---

<header class="site-header">
    <div class="site-header__inner wrapper">
        <Logo />
        <Hamburger />
        <SiteNav />
        <Button href="/contact" variant="accent" classList="site-header__cta"
            >Gesprek plannen</Button
        >
    </div>
</header>

<style lang="scss">
    .site-header {
        padding-block: 1rem;
        background: var(--color-bg);

        &__inner {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            position: relative;

            @media (width < 975px) {
                justify-content: center;
            }
        }
    }

    @media (width < 975px) {
        .site-header__cta {
            order: 1;
            margin-left: auto;
            margin-right: 1rem;
        }
    }
</style>

<style is:global>
    .site-header__cta {
        --button-font-size: var(--text-xs);
    }
</style>

<script>
    // HAMBURGER TOGGLE
    document.addEventListener("DOMContentLoaded", () => {
        const hamburger = document.querySelector(".hamburger");
        const nav = document.querySelector(".site-nav");

        if (hamburger && nav) {
            hamburger.addEventListener("click", () => {
                hamburger.classList.toggle("open");
                nav.classList.toggle("open");
            });
        }
    });
</script>
