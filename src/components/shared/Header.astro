---
import Brand from "@/components/ui/Brand.astro";
import SiteNav from "@/components/shared/Nav.astro";
import Hamburger from "@/components/ui/Hamburger.astro";
import Button from "@/components/Button.astro";
---

<header class="site-header" x-data="{ open: false }">
    <div class="site-header__inner wrapper">
        <Brand />
        <Hamburger />
        <SiteNav />
        <Button href="/contact" data-variant="primary" data-size="small">
            Gesprek plannen
        </Button>
    </div>
</header>

<style lang="scss">
    .site-header {
        padding-block: var(--space-s-m);
        background: var(--surface-page);

        &__inner {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            position: relative;

            @media (width < 975px) {
                justify-content: center;
            }
        }
    }
</style>
