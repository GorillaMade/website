---
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";

const year = new Date().getFullYear();

const navigation = [
    {
        label: "Home",
        href: "/",
    },
    {
        label: "Over mij",
        href: "/over-mij",
    },
    {
        label: "Case studies",
        href: "/case-studies",
    },
    {
        label: "Blog",
        href: "/blog",
    },
    {
        label: "Contact",
        href: "/contact",
    },
];

const services = [
    {
        label: "Webdesign",
        href: "/diensten/webdesign",
    },
    {
        label: "Development",
        href: "/diensten/development",
    },
    {
        label: "SEO",
        href: "/diensten/seo",
    },
    {
        label: "Hosting & onderhoud",
        href: "/diensten/hosting",
    },
];

const legal = [
    {
        label: "Privacy",
        href: "/privacy",
    },
    {
        label: "Algemene voorwaarden",
        href: "/algemene-voorwaarden",
    },
];
---

<footer class="footer" data-theme="dark">
    <div class="wrapper footer__inner">
        <div class="footer__brand">
            <span class="footer__logo">GorillaMade</span>
        </div>

        <div class="footer__main">
            <div class="footer__intro">
                <Heading tag="h2" variant="h2">
                    Geen gebrul.
                    <br />
                    Gewoon goed geregeld online.
                </Heading>

                <Paragraph maxWidth={35}>
                    Webdesign, development en techniek. Alles geregeld vanuit
                    één aanspreekpunt.
                </Paragraph>
            </div>

            <nav class="footer__column" aria-label="Footer navigatie">
                <span class="footer__label">Navigatie</span>

                <ul class="footer__links">
                    {navigation.map((item) => (
                        <li>
                            <a href={item.href}>{item.label}</a>
                        </li>
                    ))}
                </ul>
            </nav>

            <nav class="footer__column" aria-label="Diensten">
                <span class="footer__label">Diensten</span>

                <ul class="footer__links">
                    {services.map((item) => (
                        <li>
                            <a href={item.href}>{item.label}</a>
                        </li>
                    ))}
                </ul>
            </nav>
        </div>

        <div class="footer__bottom">
            <span>© {year} GorillaMade</span>

            <div class="footer__legal">
                {legal.map((item) => (
                    <a href={item.href}>{item.label}</a>
                ))}
            </div>
        </div>
    </div>
</footer>

<style lang="scss">
    .footer {
        background: var(--surface-page);
        padding-block: clamp(var(--space-xl), 8vw, var(--space-3xl))
            var(--space-m);

        &__inner {
            display: grid;
            gap: clamp(var(--space-xl), 7vw, var(--space-3xl));
        }

        /*
         * Brand
         */

        &__brand {
            container-type: inline-size;

            width: 100%;
            height: 7cqw;

            overflow: hidden;

            border-bottom: 1px solid var(--border-default);
        }

        &__logo {
            display: block;
            width: fit-content;
            margin-inline: auto;

            color: var(--text-primary);

            font-family: var(--font-heading);
            font-size: 14cqw;
            font-weight: var(--fw-extrabold);
            line-height: 1;
            letter-spacing: normal;
            white-space: nowrap;

            text-decoration: none;
        }

        /*
         * Main grid
         */

        &__main {
            display: grid;
            grid-template-columns:
                minmax(0, 2fr)
                minmax(9rem, 0.6fr)
                minmax(9rem, 0.6fr);

            gap: var(--space-xl);
        }

        /*
         * Intro
         */

        &__intro {
            display: grid;
            gap: var(--space-m);

            max-width: 40rem;

            :global(.text) {
                color: var(--text-primary);
            }
        }

        /*
         * Navigation
         */

        &__column {
            display: grid;
            align-content: start;
            gap: var(--space-m);
        }

        &__label {
            color: var(--text-primary);
            font-size: var(--fs--1);
            font-weight: var(--fw-semibold);
            line-height: 1;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        &__links {
            display: grid;
            gap: var(--space-xs);

            margin: 0;
            padding: 0;

            list-style: none;

            a {
                position: relative;

                display: inline-block;

                color: var(--text-secondary);
                text-decoration: none;

                transition: opacity 200ms ease;

                &::after {
                    content: "";

                    position: absolute;
                    right: 0;
                    bottom: -0.15em;
                    left: 0;

                    height: 1px;

                    background: currentColor;

                    transform: scaleX(0);
                    transform-origin: right;

                    transition: transform 250ms ease;
                }

                &:hover::after {
                    transform: scaleX(1);
                    transform-origin: left;
                }
            }
        }

        /*
         * Bottom
         */

        &__bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: var(--space-m);

            padding-block-start: var(--space-m);

            border-top: 1px solid var(--border-default);
            color: var(--text-primary);
            font-size: var(--fs--1);
        }

        &__legal {
            display: flex;
            flex-wrap: wrap;
            gap: var(--space-m);

            a {
                color: var(--text-primary);
                text-decoration: none;

                &:hover {
                    text-decoration: underline;
                    text-underline-offset: 0.2em;
                }
            }
        }

        /*
         * Mobile
         */

        @media (max-width: 48rem) {
            &__logo {
                font-size: clamp(3.25rem, 17vw, 6rem);
            }

            &__main {
                grid-template-columns: repeat(2, 1fr);
                gap: var(--space-xl) var(--space-l);
            }

            &__intro {
                grid-column: 1 / -1;
            }

            &__bottom {
                align-items: flex-start;
                flex-direction: column;
            }
        }

        @media (max-width: 30rem) {
            &__main {
                grid-template-columns: 1fr;
            }

            &__intro {
                grid-column: auto;
            }

            &__legal {
                gap: var(--space-s) var(--space-m);
            }
        }
    }
</style>
