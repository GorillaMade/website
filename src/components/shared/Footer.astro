---
import Logo from "@/components/ui/Logo.astro";

const currentYear = new Date().getFullYear();

const footerNav = [
    { label: "Showcases", href: "/showcases" },
    { label: "Over ons", href: "/about" },
    { label: "Blog", href: "/blog" },
    { label: "Contact", href: "/contact" },
];

const footerSocials = [
    {
        label: "LinkedIn",
        href: "https://www.linkedin.com/company/gorillamade",
    },
    {
        label: "Instagram",
        href: "https://instagram.com/gorillamade.nl",
    },
    {
        label: "Nostr",
        href: "https://primal.net/p/npub1s4eztsvantqp72jh2ygzk8t4q9gwva8xkqdj83kha9dupyk23kwqmlya7j",
    },
    {
        label: "GitHub",
        href: "https://github.com/GorillaMade",
    },
];

const footerLegal = [
    { label: "Algemene voorwaarden", href: "/algemene-voorwaarden" },
    { label: "Privacybeleid", href: "/privacybeleid" },
];
---

<footer class="site-footer region">
    <div class="site-footer__inner wrapper flow">
        <div class="site-footer__top">
            <div class="site-footer__brand">
                <Logo />
                <address class="fs--1 site-footer__contact">
                    <p>
                        Jouw digitale partner, van krachtige websites tot
                        hosting en zoekmachine optimalisatie, alles wat je nodig
                        hebt om te heersen in je online jungle.
                    </p>
                    <br />
                    KvK 97132756
                </address>
            </div>

            <nav class="site-footer__nav" aria-label="Footer navigatie">
                <h4 class="title">Site navigation</h4>
                <ul role="list">
                    {
                        footerNav.map((link) => (
                            <li>
                                <a href={link.href}>{link.label}</a>
                            </li>
                        ))
                    }
                </ul>
            </nav>

            <nav class="site-footer__nav" aria-label="Footer navigatie">
                <h4 class="title">Volg ons</h4>
                <ul role="list">
                    {
                        footerSocials.map((link) => (
                            <li>
                                <a href={link.href}>{link.label}</a>
                            </li>
                        ))
                    }
                </ul>
            </nav>
        </div>

        <div class="site-footer__bottom">
            <p class="fs--1 site-footer__copyright">
                &copy; {currentYear} GorillaMade. Alle rechten voorbehouden.
            </p>

            <ul class="site-footer__legal fs--1" role="list">
                {
                    footerLegal.map((link) => (
                        <li>
                            <a href={link.href}>{link.label}</a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</footer>

<style lang="scss">
    .site-footer {
        // color: var(--color-text-inverted);
        // background: var(--surface-inverted);

        .title {
            font-size: var(--text-s);
            font-weight: var(--fw-bold);
            text-transform: uppercase;
            margin-block-end: var(--gap-xs);
        }

        &__top {
            display: flex;
            flex-direction: column;
            gap: var(--space-m);
            padding-bottom: var(--space-m);

            @media (min-width: 48rem) {
                flex-direction: row;
                justify-content: space-between;
                align-items: flex-start;
            }
        }

        &__brand {
            display: flex;
            flex-direction: column;
            gap: var(--space-2xs);
        }

        &__contact {
            font-style: normal;
            color: var(--color-neutral-600);
            line-height: 1.6;

            a {
                color: inherit;
                text-decoration: none;

                &:hover {
                    text-decoration: underline;
                }
            }
        }

        &__nav ul {
            display: flex;
            flex-direction: column;
            gap: var(--space-2xs);
            list-style: none;

            // @media (min-width: 48rem) {
            //     flex-direction: row;
            //     gap: var(--space-m);
            // }
        }

        &__nav a {
            font-size: var(--fs--1);
            color: inherit;
            text-decoration: none;

            &:hover {
                text-decoration: underline;
            }
        }

        &__bottom {
            display: flex;
            flex-direction: column;
            gap: var(--space-2xs);
            padding-top: var(--space-m);
            border-top: 1px solid var(--color-neutral-200);
            color: var(--color-neutral-600);

            @media (min-width: 48rem) {
                flex-direction: row;
                justify-content: space-between;
                align-items: center;
            }
        }

        &__legal {
            display: flex;
            gap: var(--space-s);
            list-style: none;

            a {
                color: inherit;
                text-decoration: none;

                &:hover {
                    text-decoration: underline;
                }
            }
        }
    }
</style>
