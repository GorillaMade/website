---
interface Props {
    title: string;
    titleHref?: string;
    summary?: string;
    meta?: string;
    image?: string;
    imageAlt?: string;
    tags?: Tag[];
}

const {
    title,
    titleHref,
    summary,
    meta,
    image,
    imageAlt = "",
    tags = [],
} = Astro.props;
---

<article class="card">
    {image && <img class="card__image" src={image} alt={imageAlt} />}
    <div class="card__body">
        <p class="card-meta">{meta}</p>
        <h3 class="card__title">
            {
                titleHref ? (
                    <a class="card__link" href={titleHref}>
                        {title}
                    </a>
                ) : (
                    title
                )
            }
        </h3>
        <p>{summary}</p>
        {
            tags.length > 0 && (
                <ul class="card__tag-list cluster" role="list">
                    {tags.map((tag) => (
                        <li class="card__tag">
                            {tag.href ? (
                                <a href={tag.href}>{tag.label}</a>
                            ) : (
                                tag.label
                            )}
                        </li>
                    ))}
                </ul>
            )
        }
    </div>
</article>
