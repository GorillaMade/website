---
const { eyebrow, title, subtitle } = Astro.props;
---

<header class="section-header flow">
    <span class="section-header__eyebrow">{eyebrow}</span>

    <h2 class="section-header__title">
        {title}
    </h2>

    <p class="section-header__subtitle">
        {subtitle}
    </p>
</header>

<style lang="scss">
    .section-header {
        margin-block-end: var(--section-header-margin, var(--padding-xl));

        --flow-space: 1em;

        &__eyebrow {
            font-size: var(--text-xs);
            font-weight: var(--fw-semibold);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--neutral-900);
        }

        &__title {
            --flow-space: 1rem;
            font-size: var(--heading-size, var(--text-xl));
            font-weight: var(--fw-extrabold);
            line-height: 1.15;
            max-width: 28ch;
        }

        &__subtitle {
            font-size: var(--text-m);
            line-height: 1.68;
            color: var(--text-secondary);
            max-width: 50ch;
        }
    }

    .highlight {
        color: var(--accent-500);
    }
</style>
