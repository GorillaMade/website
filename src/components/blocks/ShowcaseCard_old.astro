---
import type { CollectionEntry } from "astro:content";
interface Props {
    showcase: CollectionEntry<"showcase">;
}

const { showcase } = Astro.props;
const { title, client, year, logo, description } = showcase.data;
---

<article class="showcase-card flow">
    <img
        class="showcase-card__logo"
        src={logo?.src}
        width={64}
        height={64}
        alt={`${client} logo`}
    />
    <ul class="showcase-card__meta" role="list">
        <li>
            <time>{year}</time>
        </li>
        <li>
            <span>Case study</span>
        </li>
    </ul>
    <h3 class="showcase-card__title">{title}</h3>
    <p class="showcase-card__description">{description}</p>
    <a href={`/showcases/${showcase.id}`} class="showcase-card__link"
        >Bekijk case</a
    >
</article>

<style lang="scss">
    .showcase-card {
        color: var(--color-text);
        padding: var(--padding-m);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xl);
        transition: background var(--duration-slow) var(--ease-in);

        @supports (animation-timeline: view()) {
            @media (prefers-reduced-motion: no-preference) {
                animation: card-in 1s both;
                animation-play-state: paused;
                animation-delay: calc(var(--delay-stagger, 0s) * 0.25s);

                @container style(--in-view: true) {
                    animation-play-state: running;
                }
            }
        }

        &:is(:hover, :focus-visible) {
            background: var(--surface-subtle);
        }

        &__meta {
            display: flex;
            color: var(--color-text-secondary);
            font-size: var(--text-s);
            gap: var(--gap-xs);
            padding: 0;
            list-style-type: none;

            time {
                color: var(--color-text);
                font-weight: var(--fw-semibold);
            }

            li + li {
                display: flex;
                align-items: center;
                gap: var(--gap-xs);

                &::before {
                    content: "/";
                    color: var(--color-text-disabled);
                }
            }
        }

        &__description {
            color: var(--color-text-secondary);
        }

        &__link {
            display: inline-flex;
            align-items: center;
            font-size: var(--text-s);
            font-weight: var(--fw-medium);
            color: var(--surface-inverted);
            text-decoration: none;
            border-bottom: 1px solid transparent;
            transition: border-color 0.15s ease;
            padding-bottom: 1px;

            &::after {
                content: "→";
                margin-left: 0.375rem;
            }

            &:is(:hover, :focus-visible) {
                border-bottom-color: var(--surface-inverted);
            }
        }
    }

    @keyframes card-in {
        from {
            opacity: 0;
            translate: 0 2rem;
            scale: 0.96;
        }
        to {
            opacity: 1;
            translate: 0 0;
            scale: 1;
        }
    }
</style>
