---
import SectionHeader from "@/components/blocks/SectionHeader.astro";
import ShowcaseCard from "@/components/blocks/ShowcaseCard.astro";
import CardGrid from "@/components/ui/CardGrid.astro";
import CardGridItem from "@/components/ui/CardGridItem.astro";
import { getCollection, type CollectionEntry } from "astro:content";

const showcases: CollectionEntry<"showcase">[] =
    await getCollection("showcase");
---

<section id="showcases" class="showcases region">
    <div class="wrapper">
        <SectionHeader
            eyebrow="[01 Showcases]"
            title="Digitale successen uit mijn jungle"
            subtitle="Een kleine selectie uit mijn portfolio"
        />
        <CardGrid layout="thirds" minItemSize={23} gap={2}>
            {
                showcases.map((showcase) => (
                    <CardGridItem>
                        <ShowcaseCard showcase={showcase} />
                    </CardGridItem>
                ))
            }
        </CardGrid>
    </div>
</section>
