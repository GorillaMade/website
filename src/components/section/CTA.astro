---
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Button from "@/components/Button.astro";

interface Props {
    title?: string;
    text?: string;
    button?: {
        label: string;
        href: string;
    };
}

const {
    title = "Klaar om iets sterks te bouwen?",
    text = "Heb je een idee of project? Vertel me erover.",
    button = {
        label: "Start een project",
        href: "/contact",
    },
} = Astro.props;
---

<section class="cta section" data-theme="brand">
    <div class="wrapper cta__inner">
        <div class="cta__title">
            <Heading tag="h2" variant="display">
                {title}
            </Heading>
        </div>

        <div class="cta__content">
            <Paragraph variant="large" maxWidth={32}>
                {text}
            </Paragraph>

            <Button href={button.href}>{button.label}</Button>
        </div>
    </div>
</section>

<style lang="scss">
    .cta {
        &__inner {
            display: grid;
            grid-template-columns:
                minmax(0, 1.7fr)
                minmax(18rem, 0.7fr);

            gap: clamp(var(--space-xl), 6vw, var(--space-3xl));

            align-items: end;
        }

        &__title {
            max-width: 50rem;
        }

        &__title :global(.text-style-display) {
            max-width: 10ch;

            text-wrap: balance;
        }

        &__content {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: var(--space-l);

            padding-block-end: 0.35em;
        }

        &__content :global(.text) {
            color: var(--text-secondary);
        }

        @media (max-width: 48rem) {
            &__inner {
                grid-template-columns: 1fr;
                gap: var(--space-xl);
            }

            &__title {
                max-width: 40rem;
            }

            &__title :global(.text-style-display) {
                max-width: 9ch;
            }

            &__content {
                padding-block-end: 0;
            }
        }
    }
</style>
