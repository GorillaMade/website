---
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Button from "@/components/Button.astro";

type Theme = "light" | "dark" | "secondary" | "brand";

interface Props {
    title?: string;
    text?: string;
    theme?: Theme;
    button?: {
        label: string;
        href: string;
    };
}

const {
    title = "Klaar om iets sterks te bouwen?",
    text = "Heb je een idee of project? Vertel me erover.",
    theme = "brand",
    button = {
        label: "Start een project",
        href: "/contact",
    },
} = Astro.props;
---

<section class="cta section" data-theme={theme}>
    <div class="wrapper with-aside cta__layout">
        <div class="cta__heading">
            <Heading tag="h2" variant="display" class="cta__title">
                {title}
            </Heading>
        </div>

        <aside class="cta__content flow">
            <Paragraph variant="large" maxWidth={32}>
                {text}
            </Paragraph>

            <div>
                <Button href={button.href}>{button.label}</Button>
            </div>
        </aside>
    </div>
</section>

<style lang="scss">
    .cta__layout {
        --with-aside-width: min(100%, 22rem);
        --with-aside-main-min-width: 60%;
        --with-aside-gap: var(--space-xl-2xl);

        align-items: center;
    }

    .cta__heading {
        width: 100%;
        max-width: var(--container-m);
    }

    .cta__title {
        max-width: 25ch;
        text-wrap: balance;
    }

    .cta__content {
        --flow-space: var(--space-s);
    }
</style>
