---
import SectionLabel from "@/components/section/SectionLabel.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";

type Theme = "light" | "dark" | "secondary" | "brand";

interface Service {
    title: string;
    description: string;
    href: string;
}

interface Props {
    id: string;
    label?: string;
    title: string;
    theme?: Theme;
    items?: Service[];
}

const { id, label = "Services", title, theme, items = [] } = Astro.props;
---

{items.length > 0 && (
    <section class="services section" data-theme={theme || undefined}>
        <div class="wrapper flow">
            <header class="section__header flow">
                <SectionLabel number={id} label={label} />

                <Heading tag="h2" variant="h1">
                    {title}
                </Heading>
            </header>

            <div class="services__list">
                {items.map((service, index) => (
                    <a href={service.href} class="service">
                        <span class="service__number">
                            {String(index + 1).padStart(2, "0")}
                        </span>

                        <Heading tag="h3" variant="h3" class="service__title">
                            {service.title}
                        </Heading>

                        <div class="service__description">
                            <Paragraph>{service.description}</Paragraph>
                        </div>

                        <svg
                            class="service__arrow"
                            viewBox="0 0 24 24"
                            fill="none"
                            aria-hidden="true"
                        >
                            <path
                                d="M5 12h14M13 6l6 6-6 6"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                        </svg>
                    </a>
                ))}
            </div>
        </div>
    </section>
)}

<style lang="scss">
    .services {
        --flow-space: var(--space-xl);
    }

    .services__header {
        --flow-space: var(--space-m);
        margin-block-start: var(--space-m);
        max-width: var(--container-m);
    }

    .services__list {
        border-top: 1px solid var(--border-default);
    }

    .service {
        display: grid;
        grid-template-columns:
            3rem
            minmax(16rem, 2fr)
            minmax(10rem, 1.5fr)
            auto;

        align-items: center;
        gap: var(--space-l);

        padding-block: var(--space-l);

        color: var(--text-primary);

        border-bottom: 1px solid var(--border-default);

        text-decoration: none;

        transition: border-color var(--duration-fast) var(--ease-out);

        &:hover {
            .service__title {
                color: var(--text-brand);
            }

            .service__arrow {
                transform: rotate(0);
            }
        }

        &:focus-visible {
            outline: var(--focus-width) solid var(--focus-ring);
            outline-offset: var(--focus-offset);
        }
    }

    .service__number {
        align-self: center;

        color: var(--text-muted);

        font-size: var(--text-medium);
        font-variant-numeric: tabular-nums;
    }

    .service__title {
        transition: color var(--duration-fast) var(--ease-out);
    }

    .service__description {
        max-width: 32rem;

        color: var(--text-secondary);
    }

    .service__arrow {
        width: var(--space-l);
        height: var(--space-l);

        transform: rotate(-45deg);

        transition:
            color var(--duration-fast) var(--ease-ease-in-out),
            transform var(--duration-normal) var(--ease-ease-in-out);
    }

    @media (width <= 48rem) {
        .service {
            grid-template-columns:
                2rem
                minmax(0, 1fr)
                auto;

            gap: var(--space-s) var(--space-m);
        }

        .service__description {
            grid-column: 2 / -1;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .service,
        .service__title,
        .service__arrow {
            transition: none;
        }
    }
</style>
