---
import SectionLabel from "@/components/section/SectionLabel.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Button from "@/components/Button.astro";

type Theme = "light" | "dark" | "secondary" | "brand";

interface Props {
    id: string;
    label: string;
    text: string;
    theme?: Theme;
    button?: {
        label: string;
        href: string;
    };
}

const { id, label, text, theme, button } = Astro.props;
---

<section class="story section" data-theme={theme || undefined}>
    <div class="wrapper with-aside story__layout">
        <aside>
            <SectionLabel number={id} label={label} />
        </aside>
        <div class="story__content flow">
            <Paragraph variant="h3" maxWidth={65} class="story__text">
                {text}
            </Paragraph>

            {button && (
                <div class="story__actions">
                    <Button href={button.href} variant="outline">
                        {button.label}
                    </Button>
                </div>
            )}
        </div>
    </div>
</section>

<style lang="scss">
    .story {
        overflow: hidden;
    }

    .story__layout {
        --with-aside-width: 12rem;
        --with-aside-main-min-width: 65%;
        --with-aside-gap: var(--space-xl-2xl);

        align-items: flex-start;
    }

    .story__content {
        width: 100%;
        max-width: var(--container-m);

        --flow-space: var(--space-l);
    }

    .story__text {
        font-weight: var(--fw-medium);
        line-height: var(--lh-snug);
        text-wrap: pretty;
    }

    .story__actions {
        padding-block-start: var(--space-xs);
    }
</style>
