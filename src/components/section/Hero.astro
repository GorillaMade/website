---
import SectionLabel from "@/components/section/SectionLabel.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Button from "@/components/Button.astro";

type Theme = "light" | "dark" | "secondary" | "brand";

interface HeroButton {
    label: string;
    href: string;
}

interface Props {
    id: string;
    label: string;
    title: string;
    text: string;

    theme?: Theme;

    primaryButton?: HeroButton;
    secondaryButton?: HeroButton;
}

const {
    id,
    label,
    title,
    text,
    theme = "dark",
    primaryButton,
    secondaryButton,
} = Astro.props;
---

<section class="hero" data-theme={theme}>
    <div class="wrapper hero__inner">
        <div class="hero__content flow">
            <SectionLabel number={id} label={label} />

            <Heading tag="h1" variant="display" class="hero__title">
                {title}
            </Heading>

            <Paragraph variant="large" maxWidth={48}>
                {text}
            </Paragraph>

            {(primaryButton || secondaryButton) && (
                <div class="hero__actions">
                    {primaryButton && (
                        <Button href={primaryButton.href}>
                            {primaryButton.label}
                        </Button>
                    )}

                    {secondaryButton && (
                        <Button href={secondaryButton.href} variant="outline">
                            {secondaryButton.label}
                        </Button>
                    )}
                </div>
            )}
        </div>

        <div class="hero__visual" aria-hidden="true">
            <div class="hero__browser">
                <div class="hero__browser-bar">
                    <div class="hero__browser-dots">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>

                    <div class="hero__browser-url">gorillamade.nl</div>
                </div>

                <div class="hero__browser-content">
                    <div class="hero__mockup-nav">
                        <span class="hero__mockup-logo">GorillaMade</span>

                        <div class="hero__mockup-links">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </div>

                    <div class="hero__mockup-body">
                        <span class="hero__mockup-label">
                            Website voor groei
                        </span>

                        <div class="hero__mockup-heading">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>

                        <div class="hero__mockup-copy">
                            <span></span>
                            <span></span>
                        </div>

                        <div class="hero__mockup-button"></div>
                    </div>

                    <span class="hero__mockup-accent">GM</span>
                </div>
            </div>

            <div class="hero__badge">
                <strong class="hero__badge-value">100</strong>

                <span class="hero__badge-label">Performance</span>
            </div>
        </div>
    </div>

    <div class="hero__footer">
        <div class="wrapper hero__footer-inner">
            <span>Webdesign</span>
            <span aria-hidden="true">•</span>

            <span>Development</span>
            <span aria-hidden="true">•</span>

            <span>Hosting</span>
            <span aria-hidden="true">•</span>

            <span>Onderhoud</span>
        </div>
    </div>
</section>

<style lang="scss">
    .hero {
        position: relative;

        overflow: hidden;

        background-color: var(--surface-page);
        color: var(--text-primary);

        // Subtiel technisch raster.
        &::before {
            content: "";

            position: absolute;
            inset: 0;

            background-image:
                linear-gradient(currentColor 1px, transparent 1px),
                linear-gradient(90deg, currentColor 1px, transparent 1px);

            background-size: 4rem 4rem;

            opacity: 0.015;

            pointer-events: none;
        }
    }

    // -------------------------------------------------------------------------
    // Layout
    // -------------------------------------------------------------------------

    .hero__inner {
        position: relative;
        z-index: var(--layer-raised);

        @media (width > 976px) {
            display: grid;
            align-items: center;
            gap: var(--space-xl);
        }

        padding-block: var(--section-large);
    }

    .hero__content {
        --flow-space: var(--space-l);

        position: relative;
        z-index: var(--layer-raised);
    }

    .hero__title {
        max-width: 20ch;
        margin-block-start: var(--space-m);
        text-wrap: balance;
    }

    .hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-s);

        padding-block-start: var(--space-xs);
    }

    // -------------------------------------------------------------------------
    // Visual
    // -------------------------------------------------------------------------

    .hero__visual {
        position: relative;

        width: 100%;
        max-width: 40rem;

        margin-inline: auto;

        @media (width < 975px) {
            display: none;
        }
    }

    .hero__browser {
        overflow: hidden;

        background-color: var(--surface-subtle);

        border: 1px solid var(--border-default);
        border-radius: var(--radius-m);

        box-shadow: var(--shadow-xl);

        transform: rotate(1.5deg);

        transition: transform var(--duration-slow) var(--ease-out);
    }

    .hero__visual:hover .hero__browser {
        transform: rotate(0.5deg) translateY(calc(var(--space-2xs) * -1));
    }

    // -------------------------------------------------------------------------
    // Browser chrome
    // -------------------------------------------------------------------------

    .hero__browser-bar {
        display: flex;
        align-items: center;
        gap: var(--space-s);

        min-height: 2.875rem;

        padding-inline: var(--space-m);

        background-color: var(--surface-emphasis);

        border-bottom: 1px solid var(--border-default);
    }

    .hero__browser-dots {
        display: flex;
        gap: var(--space-3xs);

        span {
            width: 0.4375rem;
            aspect-ratio: 1;

            background-color: var(--text-muted);

            border-radius: var(--radius-full);

            opacity: 0.5;
        }
    }

    .hero__browser-url {
        flex: 1;

        max-width: 15rem;

        padding: var(--space-3xs) var(--space-xs);

        overflow: hidden;

        background-color: var(--surface-subtle);
        color: var(--text-muted);

        border-radius: var(--radius-s);

        font-size: var(--text-small);

        text-overflow: ellipsis;
        white-space: nowrap;
    }

    // -------------------------------------------------------------------------
    // Browser content
    // -------------------------------------------------------------------------

    .hero__browser-content {
        position: relative;

        min-height: 24rem;

        padding: var(--space-xl);

        overflow: hidden;

        background-color: var(--surface-page);
    }

    .hero__mockup-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-m);
    }

    .hero__mockup-logo {
        color: var(--text-brand);

        font-family: var(--font-heading);
        font-weight: var(--fw-black);
        letter-spacing: var(--ls-tighter);
    }

    .hero__mockup-links {
        display: flex;
        gap: var(--space-xs);

        span {
            width: 2rem;
            height: 0.25rem;

            background-color: var(--text-muted);

            opacity: 0.4;
        }
    }

    // -------------------------------------------------------------------------
    // Mockup body
    // -------------------------------------------------------------------------

    .hero__mockup-body {
        display: flex;
        flex-direction: column;
        align-items: flex-start;

        margin-block-start: var(--space-2xl);
    }

    .hero__mockup-label {
        color: var(--text-brand);

        font-size: var(--text-small);
        font-weight: var(--fw-bold);

        letter-spacing: var(--ls-wider);
        text-transform: uppercase;
    }

    .hero__mockup-heading {
        display: grid;
        gap: var(--space-xs);

        width: min(80%, 22rem);

        margin-block-start: var(--space-m);

        span {
            display: block;

            width: 100%;
            height: clamp(1.125rem, 3vw, 1.625rem);

            background-color: var(--text-primary);

            &:nth-child(3) {
                width: 65%;
            }
        }
    }

    .hero__mockup-copy {
        display: grid;
        gap: var(--space-2xs);

        width: min(60%, 16rem);

        margin-block-start: var(--space-l);

        span {
            width: 100%;
            height: 0.3125rem;

            background-color: var(--text-muted);

            opacity: 0.5;

            &:last-child {
                width: 75%;
            }
        }
    }

    .hero__mockup-button {
        width: 7rem;
        height: 2rem;

        margin-block-start: var(--space-l);

        background-color: var(--action-primary);

        border-radius: var(--radius-xs);
    }

    // -------------------------------------------------------------------------
    // 013 accent
    // -------------------------------------------------------------------------

    .hero__mockup-accent {
        position: absolute;
        right: -0.05em;
        bottom: -0.25em;

        color: color-mix(in srgb, var(--text-brand) 7%, transparent);

        font-family: var(--font-heading);
        font-size: clamp(7rem, 22vw, 13rem);
        font-weight: var(--fw-black);
        line-height: var(--lh-none);
        letter-spacing: var(--ls-tighter);

        pointer-events: none;
        user-select: none;
    }

    // -------------------------------------------------------------------------
    // Performance badge
    // -------------------------------------------------------------------------

    .hero__badge {
        position: absolute;
        right: calc(var(--space-s) * -1);
        bottom: calc(var(--space-m) * -1);

        display: flex;
        flex-direction: column;

        min-width: 7rem;

        padding: var(--space-m);

        background-color: var(--action-primary);
        color: var(--action-primary-text);

        box-shadow: var(--shadow-l);

        transform: rotate(-3deg);

        transition: transform var(--duration-normal) var(--ease-out);
    }

    .hero__visual:hover .hero__badge {
        transform: rotate(-1deg);
    }

    .hero__badge-value {
        font-family: var(--font-heading);
        font-size: var(--heading-h3);
        font-weight: var(--fw-black);
        line-height: var(--lh-none);
    }

    .hero__badge-label {
        margin-block-start: var(--space-3xs);

        font-size: var(--text-small);
        font-weight: var(--fw-bold);

        letter-spacing: var(--ls-wide);
        text-transform: uppercase;
    }

    // -------------------------------------------------------------------------
    // Footer
    // -------------------------------------------------------------------------

    .hero__footer {
        position: relative;
        z-index: var(--layer-raised);

        border-top: 1px solid var(--border-default);
    }

    .hero__footer-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;

        gap: var(--space-xs) var(--space-m);

        padding-block: var(--space-m);

        color: var(--text-muted);

        font-size: var(--text-small);
        font-weight: var(--fw-semibold);

        letter-spacing: var(--ls-wide);
        text-transform: uppercase;

        span[aria-hidden="true"] {
            color: var(--text-brand);
        }
    }

    // -------------------------------------------------------------------------
    // Desktop
    // -------------------------------------------------------------------------

    @media (width >= 55rem) {
        .hero__inner {
            grid-template-columns:
                minmax(0, 1fr)
                minmax(24rem, 0.85fr);
        }
    }

    // -------------------------------------------------------------------------
    // Mobile
    // -------------------------------------------------------------------------

    @media (width <= 35rem) {
        .hero__inner {
            min-height: auto;

            padding-block: var(--section-medium) var(--section-large);
        }

        .hero__actions {
            flex-direction: column;
            align-items: stretch;

            :global(.button) {
                width: 100%;
            }
        }

        .hero__browser-content {
            min-height: 19rem;

            padding: var(--space-m);
        }

        .hero__badge {
            right: var(--space-xs);
        }
    }

    // -------------------------------------------------------------------------
    // Reduced motion
    // -------------------------------------------------------------------------

    @media (prefers-reduced-motion: reduce) {
        .hero__browser,
        .hero__badge {
            transition: none;
            transform: none;
        }

        .hero__visual:hover .hero__browser,
        .hero__visual:hover .hero__badge {
            transform: none;
        }
    }
</style>
