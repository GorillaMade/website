---
import { getCollection } from "astro:content";

import SectionLabel from "@/components/section/SectionLabel.astro";
import Heading from "@/components/Typography/Heading.astro";
import Card from "@/components/Card.astro";
import Button from "@/components/Button.astro";

type Theme = "light" | "dark" | "secondary" | "brand";

interface Props {
    id: string;
    label: string;
    title: string;
    theme?: Theme;
    limit?: number;

    button?: {
        label: string;
        href: string;
    };
}

const {
    id,
    label,
    title,
    theme,
    limit = 3,
    button = {
        label: "Alle showcases",
        href: "/showcases",
    },
} = Astro.props;

const showcases = await getCollection("showcase", ({ data }) => data.featured);

const items = showcases.slice(0, limit);
---

{items.length > 0 && (
    <section
        id="work"
        class="showcases section"
        data-theme={theme || undefined}
    >
        <div class="wrapper flow">
            <div class="repel">
                <header class="section__header">
                    <SectionLabel number={id} label={label} />

                    <Heading tag="h2" variant="h1">
                        {title}
                    </Heading>
                </header>

                <Button href={button.href} variant="outline">
                    {button.label}
                </Button>
            </div>

            <div class="grid" data-layout="thirds">
                {items.map((item, index) => (
                    <Card entry={item} index={index + 1} />
                ))}
            </div>
        </div>
    </section>
)}

<style lang="scss">
    .grid[data-layout="halves"] {
        --grid-placement: auto-fill;
    }
</style>
