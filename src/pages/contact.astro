---
import BaseLayout from "@/layouts/BaseLayout.astro";

import SectionLabel from "@/components/section/SectionLabel.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import ContactForm from "@/components/form/ContactForm.astro";

import { frontmatter } from "@/content/pages/contact.md";

const { seo, hero, contact } = frontmatter;
---

<BaseLayout title={seo.title} description={seo.description}>
    <section class="contact-hero section" data-theme={hero.theme || undefined}>
        <div class="wrapper flow">
            <SectionLabel number={hero.id} label={hero.label} />

            <div class="contact-hero__content">
                <Heading tag="h1" variant="display">
                    {hero.title}
                </Heading>

                <Paragraph variant="large" maxWidth={40}>
                    {hero.text}
                </Paragraph>
            </div>
        </div>
    </section>

    <section class="contact section" data-theme={contact.theme || undefined}>
        <div class="wrapper with-aside contact__layout">
            <main class="contact__main">
                <ContactForm
                    services={contact.services}
                    buttonLabel={contact.buttonLabel}
                />
            </main>

            <aside class="contact__aside flow">
                <div class="contact__block flow">
                    <SectionLabel number="02" label="Direct contact" />

                    <div class="contact__details">
                        {contact.email && (
                            <a href={`mailto:${contact.email}`}>
                                {contact.email}
                            </a>
                        )}

                        {contact.location && <span>{contact.location}</span>}
                    </div>
                </div>

                {contact.expectations?.length > 0 && (
                    <div class="contact__block flow">
                        <Heading tag="h2" variant="h4">
                            Wat kun je verwachten?
                        </Heading>

                        <ol class="contact__expectations">
                            {contact.expectations.map((item, index) => (
                                <li>
                                    <span>
                                        {String(index + 1).padStart(2, "0")}
                                    </span>

                                    <p>{item}</p>
                                </li>
                            ))}
                        </ol>
                    </div>
                )}
            </aside>
        </div>
    </section>
</BaseLayout>

<style lang="scss">
    .contact-hero__content {
        display: grid;
        gap: var(--space-l);

        @media (width > 48rem) {
            grid-template-columns:
                minmax(0, 2fr)
                minmax(18rem, 1fr);
            align-items: center;
        }
    }

    .contact__layout {
        --with-aside-width: 18rem;
        --with-aside-main-min-width: 60%;
        --with-aside-gap: var(--space-xl-2xl);

        align-items: flex-start;
    }

    .contact__main {
        width: 100%;
    }

    .contact__aside {
        --flow-space: var(--space-xl);
    }

    .contact__block {
        --flow-space: var(--space-m);
    }

    .contact__details {
        display: grid;
        gap: var(--space-xs);

        color: var(--text-secondary);

        a {
            color: var(--text-primary);
            text-decoration: none;

            &:hover {
                text-decoration: underline;
                text-underline-offset: 0.2em;
            }
        }
    }

    .contact__expectations {
        display: grid;

        margin: var(--space-m) 0 0 0;
        padding: 0;

        list-style: none;

        li {
            display: grid;
            grid-template-columns: auto 1fr;
            gap: var(--space-s);

            padding-block: var(--space-s);

            border-top: 1px solid var(--border-default);

            &:last-child {
                border-bottom: 1px solid var(--border-default);
            }
        }

        span {
            color: var(--text-muted);

            font-size: var(--text-small);
            font-variant-numeric: tabular-nums;
        }

        p {
            margin: 0;

            color: var(--text-primary);

            font-size: var(--text-small);
            line-height: var(--lh-body);
        }
    }
</style>
