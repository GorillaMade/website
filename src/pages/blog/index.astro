---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Card from "@/components/Card.astro";

import CTA from "@/components/section/CTA.astro";

import { getCollection } from "astro:content";
const posts = await getCollection("blog");

// Unieke categorieën ophalen uit alle posts, voor de filter-knoppen
const categories = [...new Set(posts.map((post) => post.data.category))].sort();
---

<BaseLayout
    title="Blog | GorillaMade Webdesign & Development"
    description="Inzichten, tips en verhalen over webdesign, development en digitale groei — geschreven door GorillaMade voor ondernemers die meer uit hun website willen halen."
>
    <section class="hero section">
        <div class="wrapper flow">
            <Heading tag="h1" variant="display">
                Digital Stories
            </Heading>
            <Paragraph variant="large" maxWidth={65}>
                Inzichten, tutorials en strategieën over design, development en
                digitale groei.
            </Paragraph>
        </div>
    </section>
    <section class="section">
        <div class="wrapper">
            <ul class="grid" role="list" data-layout="thirds">
                {posts.map((post, index) => (
                    <li
                        x-show={`activeCategory === 'all' || activeCategory === '${post.data.category}'`}
                        x-transition
                    >
                        <Card entry={post} index={index + 1} />
                    </li>
                ))}
            </ul>
        </div>
    </section>
    <CTA />
</BaseLayout>

<style lang="scss">
    .grid[data-layout="halves"] {
        --grid-placement: auto-fill;
    }
</style>
