---
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";

import BaseLayout from "@/layouts/BaseLayout.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import CTA from "@/components/section/CTA.astro";

export async function getStaticPaths() {
    const posts: CollectionEntry<"blog">[] = await getCollection("blog");

    return posts.map((post) => ({
        params: {
            slug: post.id,
        },
        props: {
            post,
        },
    }));
}

interface Props {
    post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const { title, date, description, category, image, author } = post.data;

const { Content } = await render(post);

const formattedDate = date.toLocaleDateString("nl-NL", {
    day: "numeric",
    month: "short",
    year: "numeric",
});

// SEO.
const canonicalURL = Astro.url.href;

const imageURL = image
    ? typeof image.src === "string"
        ? new URL(image.src, Astro.site).href
        : new URL(image.src.src, Astro.site).href
    : new URL("/og-image.jpg", Astro.site).href;

// Structured data.
const structuredData = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": `${canonicalURL}#article`,

    headline: title,
    description,
    url: canonicalURL,
    image: imageURL,

    datePublished: date.toISOString(),

    articleSection: category,
    inLanguage: "nl-NL",

    mainEntityOfPage: {
        "@type": "WebPage",
        "@id": canonicalURL,
    },

    author: {
        "@type": "Person",
        name: author.name,
    },

    publisher: {
        "@type": "Organization",
        "@id": `${Astro.site}#organization`,
        name: "GorillaMade",
    },

    isPartOf: {
        "@id": `${Astro.site}#website`,
    },
};
---

<BaseLayout
    title={title}
    description={description}
    image={imageURL}
    structuredData={structuredData}
>
    <article class="article">
        <!-- Hero -->
        <header class="article__hero section">
            <div class="wrapper">
                <div class="article__intro">
                    <Heading tag="h1" variant="display" class="article__title">
                        {title}
                    </Heading>

                    <Paragraph
                        variant="large"
                        maxWidth={60}
                        class="article__description"
                    >
                        {description}
                    </Paragraph>
                </div>
            </div>
        </header>

        <!-- Cover -->
        {image && (
            <div class="wrapper">
                <figure class="article__image">
                    {typeof image.src === "string" ? (
                        <img
                            src={image.src}
                            alt={image.alt}
                            width="1800"
                            height="1000"
                            fetchpriority="high"
                        />
                    ) : (
                        <Image
                            src={image.src}
                            alt={image.alt}
                            width={1800}
                            height={1000}
                            fetchpriority="high"
                        />
                    )}
                </figure>
            </div>
        )}

        <!-- Content -->
        <section class="article__body section">
            <div
                class="wrapper with-aside article__layout"
                data-direction="reverse"
            >
                <aside class="article__aside" aria-label="Artikelinformatie">
                    <div class="article__meta">
                        <span class="article__meta-label">Geschreven door</span>

                        <strong>{author.name}</strong>
                    </div>

                    <div class="article__meta">
                        <span class="article__meta-label">Gepubliceerd</span>

                        <time datetime={date.toISOString()}>
                            {formattedDate}
                        </time>
                    </div>

                    <div class="article__meta">
                        <span class="article__meta-label">Categorie</span>

                        <span>{category}</span>
                    </div>
                </aside>

                <div class="article__content prose flow">
                    <Content />
                </div>
            </div>
        </section>
    </article>

    <CTA />
</BaseLayout>

<style lang="scss">
    // =========================================================================
    // Hero
    // =========================================================================

    .article__hero {
        padding-block-end: var(--space-xl);
    }

    .article__intro {
        display: flex;
        flex-direction: column;
        align-items: start;
        gap: var(--space-l);

        padding-block-start: var(--space-s);
        max-width: var(--container-l);
    }

    .article__title {
        max-inline-size: 50ch;
    }

    .article__description {
        color: var(--text-secondary);
    }

    // =========================================================================
    // Cover
    // =========================================================================

    .article__image {
        overflow: clip;

        aspect-ratio: 16 / 8;
        margin: 0;

        background-color: var(--surface-subtle);

        border-radius: var(--radius-l);
    }

    .article__image :global(img) {
        display: block;

        width: 100%;
        height: 100%;

        object-fit: cover;
    }

    // =========================================================================
    // Layout
    // =========================================================================

    .article__layout {
        --with-aside-width: 12rem;
        --with-aside-main-min-width: 60%;
        --with-aside-gap: var(--space-xl-2xl);

        align-items: flex-start;
    }

    // =========================================================================
    // Content
    // =========================================================================

    .article__content {
        --prose-max-width: var(--container-s);
    }

    // =========================================================================
    // Aside
    // =========================================================================

    .article__aside {
        position: sticky;
        top: var(--space-l);

        display: grid;
        gap: var(--space-l);

        font-size: var(--text-small);
    }

    .article__meta {
        display: grid;
        gap: var(--space-3xs);

        color: var(--text-secondary);
    }

    .article__meta-label {
        color: var(--text-muted);

        font-size: var(--text-small);
        font-weight: var(--fw-strong);
        line-height: var(--lh-none);
        letter-spacing: var(--ls-wider);

        text-transform: uppercase;
    }

    .article__meta strong {
        color: var(--text-primary);
        font-weight: var(--fw-strong);
    }

    // =========================================================================
    // Responsive
    // =========================================================================

    @media (max-width: 48rem) {
        .article__image {
            aspect-ratio: 4 / 3;
        }

        .article__aside {
            position: static;

            grid-template-columns: repeat(3, minmax(0, 1fr));

            padding-block-end: var(--space-l);

            border-block-end: 1px solid var(--border-default);
        }
    }

    @media (max-width: 32rem) {
        .article__aside {
            grid-template-columns: 1fr;
            gap: var(--space-m);
        }
    }
</style>
