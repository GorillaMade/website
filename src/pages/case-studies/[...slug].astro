---
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";

import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionLabel from "@/components/section/SectionLabel.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import CTA from "@/components/section/CTA.astro";

export async function getStaticPaths() {
    const showcases: CollectionEntry<"showcase">[] =
        await getCollection("showcase");

    return showcases.map((showcase) => ({
        params: {
            slug: showcase.id,
        },
        props: {
            showcase,
        },
    }));
}

interface Props {
    showcase: CollectionEntry<"showcase">;
}

const { showcase } = Astro.props;

const {
    title,
    tagline,
    description,
    client,
    year,
    category,
    image,
    cover,
    services,
    quote,
    quoteAuthor,
    quoteAuthorFunction,
    results,
} = showcase.data;

const { Content } = await render(showcase);
---

<BaseLayout title={`${title} | GorillaMade`} description={description}>
    <article class="case-study">
        <!-- ================================================================
             Header
        ================================================================= -->

        <header class="case-study__header section">
            <div class="wrapper flow">
                <SectionLabel label="Case Study" />

                <div class="case-study__intro flow">
                    <Heading tag="h1" variant="display">
                        {title}
                    </Heading>

                    <Paragraph variant="large">{tagline}</Paragraph>
                </div>
            </div>
        </header>

        <!-- ================================================================
             Project details
        ================================================================= -->

        <section class="case-study__details" aria-label="Projectdetails">
            <div class="wrapper">
                <dl class="case-study__meta">
                    <div class="case-study__meta-item">
                        <dt>Client</dt>
                        <dd>{client}</dd>
                    </div>

                    <div class="case-study__meta-item">
                        <dt>Jaar</dt>
                        <dd>{year}</dd>
                    </div>

                    <div class="case-study__meta-item">
                        <dt>Services</dt>
                        <dd>{services.join(", ")}</dd>
                    </div>
                </dl>
            </div>
        </section>

        <!-- ================================================================
             Main visual
        ================================================================= -->

        {image && (
            <figure class="case-study__cover">
                {typeof image.src === "string" ? (
                    <img
                        src={image.src}
                        alt={image.alt}
                        width="1800"
                        height="1000"
                        loading="eager"
                    />
                ) : (
                    <Image
                        src={image.src}
                        alt={image.alt}
                        width={1800}
                        height={1000}
                    />
                )}
            </figure>
        )}

        <!-- ================================================================
             Case story
        ================================================================= -->

        <section class="case-study__story section">
            <div
                class="wrapper with-aside case-study__story-layout"
                data-direction="reverse"
            >
                <main class="case-study__content flow">
                    <Content />
                </main>

                <aside class="case-study__story-aside">
                    <SectionLabel number="02" label="De case" />
                </aside>
            </div>
        </section>

        <!-- ================================================================
             Secondary visual
        ================================================================= -->

        {cover && (
            <section class="case-study__secondary-visual">
                <div class="wrapper">
                    <figure class="case-study__secondary-cover">
                        {typeof cover.src === "string" ? (
                            <img
                                src={cover.src}
                                alt={cover.alt}
                                width="1800"
                                height="1200"
                                loading="lazy"
                            />
                        ) : (
                            <Image
                                src={cover.src}
                                alt={cover.alt}
                                width={1800}
                                height={1200}
                                loading="lazy"
                            />
                        )}
                    </figure>
                </div>
            </section>
        )}

        <!-- ================================================================
             Quote
        ================================================================= -->

        {quote && (
            <section class="case-study__quote-section section">
                <div class="wrapper">
                    <figure class="case-study__quote with-aside">
                        {(quoteAuthor || quoteAuthorFunction) && (
                            <figcaption class="case-study__author">
                                {quoteAuthor && <strong>{quoteAuthor}</strong>}

                                {quoteAuthorFunction && (
                                    <span>{quoteAuthorFunction}</span>
                                )}
                            </figcaption>
                        )}

                        <blockquote>“{quote}”</blockquote>
                    </figure>
                </div>
            </section>
        )}

        <!-- ================================================================
             Results
        ================================================================= -->

        {results && results.length > 0 && (
            <section class="case-study__results section" data-theme="dark">
                <div class="wrapper">
                    <div class="case-study__results-heading flow">
                        <SectionLabel number="03" label="Resultaat" />

                        <Heading tag="h2" variant="h2">
                            Meetbaar resultaat.
                        </Heading>
                    </div>

                    <div class="case-study__results-grid">
                        {results.map((result) => (
                            <dl class="case-study__stat">
                                <dd>{result.value}</dd>

                                <dt>{result.label}</dt>
                            </dl>
                        ))}
                    </div>
                </div>
            </section>
        )}
    </article>

    <CTA />
</BaseLayout>

<style lang="scss">
    .case-study {
        // ---------------------------------------------------------------------
        // Header
        // ---------------------------------------------------------------------

        &__header {
            display: flex;
            flex-direction: column;
        }

        &__intro {
            max-width: var(--container-l);
        }

        // ---------------------------------------------------------------------
        // Project details
        // ---------------------------------------------------------------------

        &__details {
            border-block: 1px solid var(--border-default);
        }

        &__meta {
            display: grid;
            grid-template-columns: repeat(3, 1fr);

            max-width: var(--container-l);

            margin-block: 0;
            margin-inline: auto;
        }

        &__meta-item {
            padding: var(--space-m);

            border-inline-start: 1px solid var(--border-default);

            &:last-of-type {
                border-inline-end: 1px solid var(--border-default);
            }

            dt {
                margin-block-end: var(--space-3xs);

                color: var(--text-primary);

                font-family: var(--font-body);
                font-size: var(--text-small);
                font-weight: var(--fw-strong);
                line-height: var(--lh-none);
            }

            dd {
                margin: 0;

                color: var(--text-secondary);

                font-family: var(--font-body);
                font-size: var(--text-small);
                font-weight: var(--fw-body);
                line-height: var(--lh-body);
            }
        }

        // ---------------------------------------------------------------------
        // Main visual
        // ---------------------------------------------------------------------

        &__cover {
            margin: 0;

            background-color: var(--surface-subtle);

            border-block-end: 1px solid var(--border-default);

            img {
                display: block;

                width: 100%;
                max-width: var(--container-l);
                height: auto;

                margin-inline: auto;
            }
        }

        // ---------------------------------------------------------------------
        // Case story
        // ---------------------------------------------------------------------

        &__story-layout {
            --with-aside-width: 14rem;
            --with-aside-main-min-width: 60%;
            --with-aside-gap: var(--space-xl-2xl);

            align-items: flex-start;
        }

        &__story-aside {
            position: sticky;
            top: var(--space-xl);

            align-self: flex-start;
        }

        &__content {
            width: 100%;
            max-width: var(--container-m);

            --flow-space: var(--space-m);
        }

        // ---------------------------------------------------------------------
        // Markdown: headings
        // ---------------------------------------------------------------------

        &__content :global(h2) {
            margin-block-start: var(--section-medium);

            color: var(--text-primary);

            font-family: var(--font-heading);
            font-size: var(--heading-h2);
            font-weight: var(--fw-heading);
            line-height: var(--lh-heading);
            letter-spacing: var(--ls-heading);

            text-wrap: balance;
        }

        &__content :global(h2:first-child) {
            margin-block-start: 0;
        }

        &__content :global(h3) {
            margin-block-start: var(--space-xl);

            color: var(--text-primary);

            font-family: var(--font-heading);
            font-size: var(--heading-h4);
            font-weight: var(--fw-heading);
            line-height: var(--lh-heading);
            letter-spacing: var(--ls-heading);

            text-wrap: balance;
        }

        &__content :global(h4) {
            margin-block-start: var(--space-l);

            color: var(--text-primary);

            font-family: var(--font-heading);
            font-size: var(--heading-h5);
            font-weight: var(--fw-heading);
            line-height: var(--lh-heading);
            letter-spacing: var(--ls-heading);
        }

        // ---------------------------------------------------------------------
        // Markdown: body
        // ---------------------------------------------------------------------

        &__content :global(p) {
            color: var(--text-secondary);

            font-family: var(--font-body);
            font-size: var(--text-base);
            font-weight: var(--fw-body);
            line-height: var(--lh-body);
            letter-spacing: var(--ls-body);
        }

        // Eerste alinea onder een H2 iets prominenter.
        &__content :global(h2 + p) {
            color: var(--text-primary);

            font-size: var(--text-large);
            line-height: var(--lh-moderate);
        }

        &__content :global(strong) {
            color: var(--text-primary);
            font-weight: var(--fw-strong);
        }

        &__content :global(em) {
            color: var(--text-secondary);
        }

        // ---------------------------------------------------------------------
        // Markdown: links
        // ---------------------------------------------------------------------

        &__content :global(a) {
            color: var(--text-brand);

            text-decoration-thickness: 1px;
            text-underline-offset: var(--space-3xs);

            transition: color var(--duration-fast) var(--ease-ease-out);

            &:hover {
                color: var(--text-primary);
            }

            &:focus-visible {
                outline: var(--focus-width) solid var(--focus-color);

                outline-offset: var(--focus-offset);
            }
        }

        // ---------------------------------------------------------------------
        // Markdown: lists
        // ---------------------------------------------------------------------

        &__content :global(ul),
        &__content :global(ol) {
            display: grid;
            gap: var(--space-xs);

            margin-block: 0;
            padding-inline-start: var(--space-m);

            color: var(--text-secondary);

            font-family: var(--font-body);
            font-size: var(--text-base);
            line-height: var(--lh-body);
        }

        &__content :global(li::marker) {
            color: var(--text-brand);
        }

        // ---------------------------------------------------------------------
        // Markdown: blockquote
        // ---------------------------------------------------------------------

        &__content :global(blockquote) {
            margin-block: var(--space-xl);
            margin-inline: 0;

            padding-inline-start: var(--space-m);

            color: var(--text-primary);

            border-inline-start: 2px solid var(--border-brand);

            font-family: var(--font-heading);
            font-size: var(--text-large);
            font-weight: var(--fw-heading);
            line-height: var(--lh-heading);
            letter-spacing: var(--ls-heading);
        }

        &__content :global(blockquote p) {
            color: inherit;
            font: inherit;
            letter-spacing: inherit;
        }

        // ---------------------------------------------------------------------
        // Markdown: divider
        // ---------------------------------------------------------------------

        &__content :global(hr) {
            width: 100%;
            height: 1px;

            margin-block: var(--space-xl);

            background-color: var(--border-default);

            border: 0;
        }

        // ---------------------------------------------------------------------
        // Secondary visual
        // ---------------------------------------------------------------------

        &__secondary-visual {
            padding-block-end: var(--section-large);
        }

        &__secondary-cover {
            overflow: hidden;

            margin: 0;

            background-color: var(--surface-subtle);

            border-radius: var(--radius-m);

            img {
                display: block;

                width: 100%;
                height: auto;
            }
        }

        // ---------------------------------------------------------------------
        // Quote
        // ---------------------------------------------------------------------

        &__quote-section {
            background-color: var(--surface-page);
            color: var(--text-primary);
        }

        &__quote {
            display: grid;
            grid-template-columns: 1fr;
            gap: 2rem;

            max-width: var(--container-l);
            margin-inline: auto;
            margin-block: 8rem;
            padding-inline: 5dvw;

            @media (width > 48rem) {
                grid-template-columns: 20rem 1fr;
            }

            blockquote {
                font-size: var(--text-large);
                line-height: 1.5;
                color: var(--text-secondary);
                order: 2;
                font-style: italic;
            }
        }

        &__author {
            margin-right: 2rem;

            strong {
                font-size: var(--fs-1);
                display: block;
            }

            span {
                color: var(--text-secondary);
                font-size: var(--fs--1);
            }
        }

        // ---------------------------------------------------------------------
        // Results
        // ---------------------------------------------------------------------

        &__results {
            background-color: var(--surface-page);
            color: var(--text-primary);
        }

        &__results-heading {
            max-width: var(--container-s);

            margin-block-end: var(--section-medium);

            --flow-space: var(--space-m);
        }

        &__results-grid {
            display: grid;
            grid-template-columns: repeat(
                auto-fit,
                minmax(min(14rem, 100%), 1fr)
            );

            border-block-start: 1px solid var(--border-default);
        }

        &__stat {
            display: flex;
            flex-direction: column-reverse;
            gap: var(--space-s);

            min-width: 0;

            margin: 0;

            padding-block: var(--space-l);
            padding-inline: var(--space-m);

            border-inline-start: 1px solid var(--border-default);

            &:last-child {
                border-inline-end: 1px solid var(--border-default);
            }

            dt {
                color: var(--text-muted);

                font-family: var(--font-body);
                font-size: var(--text-small);
                font-weight: var(--fw-strong);
                line-height: var(--lh-none);

                letter-spacing: var(--ls-wider);
                text-transform: uppercase;
            }

            dd {
                margin: 0;

                color: var(--text-primary);

                font-family: var(--font-heading);
                font-size: var(--heading-h2);
                font-weight: var(--fw-heading);
                line-height: var(--lh-heading);
                letter-spacing: var(--ls-heading);
            }
        }
    }

    // =========================================================================
    // Mobile
    // =========================================================================

    @media (max-width: 48rem) {
        .case-study {
            &__meta {
                grid-template-columns: 1fr;
            }

            &__meta-item {
                padding-inline: 0;

                border-inline: 0;

                &:last-of-type {
                    border-inline-end: 0;
                }

                &:not(:first-of-type) {
                    border-block-start: 1px solid var(--border-default);
                }
            }

            &__story-aside {
                position: static;
            }

            &__secondary-cover {
                border-radius: var(--radius-s);
            }

            &__results-grid {
                grid-template-columns: 1fr;
            }

            &__stat {
                padding-inline: 0;

                border-inline: 0;
                border-block-end: 1px solid var(--border-default);

                &:last-child {
                    border-inline-end: 0;
                }
            }
        }
    }

    // =========================================================================
    // Reduced motion
    // =========================================================================

    @media (prefers-reduced-motion: reduce) {
        .case-study {
            &__content :global(a) {
                transition: none;
            }
        }
    }
</style>
