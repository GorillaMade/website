---
import { getCollection } from "astro:content";

import BaseLayout from "@/layouts/BaseLayout.astro";

import SectionLabel from "@/components/section/SectionLabel.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Card from "@/components/Card.astro";

import CollectionFilter from "@/components/collection/CollectionFilter.astro";
import CallToAction from "@/components/section/CTA.astro";

import { frontmatter } from "@/content/pages/showcases.md";

const { seo, hero } = frontmatter;

const structuredData = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${Astro.url.href}#webpage`,
    url: Astro.url.href,
    name: seo.title,
    description: seo.description,
    inLanguage: "nl-NL",
    isPartOf: {
        "@id": `${Astro.site}#website`,
    },
};

const showcases = await getCollection("showcase");

// Unieke categorieën voor het filter.
const categories = [
    ...new Set(showcases.map((showcase) => showcase.data.category)),
].sort();
---

<BaseLayout
    title={seo.title}
    description={seo.description}
    structuredData={structuredData}
>
    <!-- Hero -->
    <section class="hero section" data-theme={hero.theme || undefined}>
        <div class="wrapper flow">
            <SectionLabel number={hero.id} label={hero.label} />

            <div class="hero__content flow">
                <Heading tag="h1" variant="display">
                    {hero.title}
                </Heading>

                <Paragraph variant="large" maxWidth={65}>
                    {hero.text}
                </Paragraph>
            </div>
        </div>
    </section>

    <!-- Cases -->
    <section class="collection section" aria-label="Case studies">
        <div class="wrapper">
            <CollectionFilter categories={categories} pageSize={6}>
                <ul class="grid" role="list" data-layout="halves">
                    {showcases.map((showcase, index) => (
                        <li
                            data-collection-item
                            data-category={showcase.data.category}
                        >
                            <Card entry={showcase} index={index + 1} />
                        </li>
                    ))}
                </ul>
            </CollectionFilter>
        </div>
    </section>

    <CallToAction />
</BaseLayout>

<style lang="scss">
    .hero {
        padding-block-end: 0;

        &__content {
            margin-block-start: var(--space-m);
        }
    }

    .grid[data-layout="halves"] {
        --grid-placement: auto-fill;
    }
</style>
