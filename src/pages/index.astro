---
import { getCollection } from "astro:content";

import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionLabel from "@/components/section/SectionLabel.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import Card from "@/components/Card.astro";

import Hero from "@/components/section/Hero.astro";
import Story from "@/components/section/Story.astro";
import Showcases from "@/components/section/Showcases.astro";
import Services from "@/components/section/Services.astro";
import Statement from "@/components/section/Statement.astro";
import Testimonials from "@/components/section/Testimonials.astro";
import Faq from "@/components/section/FAQ.astro";
import Cta from "@/components/section/CTA.astro";

import { frontmatter } from "@/content/pages/home.md";

const {
    seo,
    hero,
    story,
    services,
    showcases,
    statement,
    testimonials,
    faq,
    cta,
} = frontmatter;

/*
 * Featured case studies voor homepage
 */
const featuredCaseStudies = await getCollection(
    "showcase",
    ({ data }) => data.featured,
);
---

<BaseLayout title={seo.title} description={seo.description}>
    <!-- HERO -->
    <Hero {...hero} />
    <!-- SHOWCASES -->
    <Showcases {...showcases} />
    <!-- STORY -->
    <Story {...story} />
    <!-- SERVICES -->
    <Services {...services} />
    <!-- STATEMENT -->
    <Statement {...statement} />
    <!-- TESTIMONIALS -->
    <Testimonials {...testimonials} />
    <!-- CTA -->
    <Cta {...cta} />
    <!-- FAQ -->
    <Faq {...faq} />
</BaseLayout>
